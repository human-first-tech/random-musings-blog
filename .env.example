# ─────────────────────────────────────────────────
# Notion CMS (required for the site to render)
# ─────────────────────────────────────────────────

# Internal Integration Token from https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 32-character database ID from the Writings database URL
# (paste full URL — script extracts the ID portion)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────
# Revalidation webhook (POST /api/revalidate?secret=...)
# ─────────────────────────────────────────────────

# Random string. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# ─────────────────────────────────────────────────
# Site URL (used in RSS, sitemap, OG tags)
# ─────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://www.d-island-girl.com

# ─────────────────────────────────────────────────
# One-shot migration script options (optional)
# ─────────────────────────────────────────────────

# Limit to first N posts. Useful for the pilot (set to 3).
# IMPORT_LIMIT=3

# Import as Draft so you can review in Notion before publishing live.
# IMPORT_STATUS=Draft

# Re-import existing slugs (archives the old page first).
# IMPORT_OVERWRITE=true
